{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "saboot-flask-api"
      }
    }
  ],
  "services": {
    "saboot-flask-api": {
      "root": ".",
      "buildCommand": "pip install -r requirements.txt",
      "entrypoint": "app.py"
    }
  }
}
